# 复制为仓库根目录的 .env 后填写；.env 不进版本库
# 默认值仅适用于本机 / 演示环境；带 <...> 的项必须替换成真实值再启动

# ---- 数据库（postgres 容器）----
POSTGRES_DB=omniagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- 全量编排对外端口（Nginx：前端 + /api + /agent 同源入口）----
WEB_PORT=8081

# ---- 预构建镜像 ----
# 使用者保持默认：compose 会先拉取 GHCR 公开镜像，不触发本地编译。
# 命名空间与本项目 GitHub 账号不一致时改 IMAGE_REGISTRY；固定版本改 IMAGE_TAG。
# 想从源码构建：docker compose up -d --build
IMAGE_REGISTRY=ghcr.io/eny-o
IMAGE_TAG=latest

# ---- 共享密钥（Java 签发/验签、Agent 验签；compose 同时注入两端）----
# 必须 ≥ 32 字节：JJWT 的 HS256 拒绝短密钥，登录会在签发 Token 时抛 WeakKeyException。
# 下面与 compose 默认值一致的演示值已满足长度，clone 后不改也能启动；
# 对外部署务必用 openssl rand -hex 32 重新生成，改后需 force-recreate java agent。
JWT_SECRET=omniagent-dev-secret-please-change-in-prod-1234567890

# ---- 大模型 / Embedding 密钥（必填，否则 AI 助手不可用）----
DEEPSEEK_API_KEY=<你的 DeepSeek API Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=<你的百炼 API Key>

# ---- 可选：LangSmith 追踪 ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omniagent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 说明：
# - SPRING_DATASOURCE_* 与 PG_DSN 由 compose 依据 POSTGRES_* 自动拼装，无需手填；
#   密码若含 @ : / 等 URL 特殊字符需先做 URL 编码，否则 PG_DSN 会被解析错。
# - VITE_AGENT_BASE 是构建期参数，已在 compose 的 build.args 固定为 /agent；
#   OMNIAGENT_API_BASE_URL 固定为 http://java:8080；两者都无需手填。
# - DEEPSEEK_MODEL 目前是 agent_service.py 里硬编码的 deepseek:deepseek-v4-flash，
#   EMBEDDING_DIM 锁死为 vector(1024)，配置不生效，故不列出。
# - 只起数据库并在本机跑三端时，本文件的容器服务名不会影响本机进程：
#   Java 读 application.yml、Agent 读自己的 .env，都指向 localhost。
